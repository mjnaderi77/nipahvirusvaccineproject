title                   = Nipah virus complex NVT equilibration
define                  = -DPOSRES

integrator              = md
dt                      = 0.002
nsteps                  = 50000       ; 100 ps

nstxout-compressed      = 1000
nstenergy               = 1000
nstlog                  = 1000

continuation            = no
constraint_algorithm    = lincs
constraints             = h-bonds

cutoff-scheme           = Verlet
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
pme-order               = 4
fourierspacing          = 0.12

tcoupl                  = V-rescale
tc-grps                 = Protein Water_and_ions
tau_t                   = 0.1 0.1
ref_t                   = 300 300

pcoupl                  = no

pbc                     = xyz
gen_vel                 = yes
gen_temp                = 300
gen_seed                = 2026
