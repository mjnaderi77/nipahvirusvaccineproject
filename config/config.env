# =========================
# Nipah virus GROMACS config
# =========================

# Input
INPUT_PDB="data/input/complex.pdb"

# Output directories
RUN_DIR="results/md"
ANALYSIS_DIR="results/analysis"
LOG_DIR="logs"

# Force field / water
WATER="tip3p"

# Box
BOX_DISTANCE="1.0"
BOX_TYPE="cubic"

# Solvent/ions
SALT_CONC="0.15"
ION_POS="+"
ION_NEG="-"

# Thermodynamic conditions
TEMPERATURE="300"
PRESSURE="1.0"

# Production MD
# 150 ns = 75,000,000 steps at dt=0.002 ps
PRODUCTION_NS="150"
DT_PS="0.002"

# Seeds
NVT_SEED="2026"
NPT_SEED="2027"

# GROMACS command
GMX="gmx"
